# Copy to .env and fill in. Never commit .env.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides
# FIGURE=the president          # who the alerts are about; used in prompts and push titles
# LLM_MODEL=claude-haiku-4-5
# LLM_ENABLED=1
# LLM_DEBOUNCE_SECONDS=1.0
# LLM_MIN_CONFIDENCE=0.7
# COOLDOWN_SECONDS=600
# DIARIZE=1                      # Deepgram speaker labels; heads-ups only for the dominant speaker
# SPEAKER_WINDOW_SECONDS=300     # window over which "who talks most" is measured
# SPEAKER_MIN_WORDS=60           # words a speaker needs before the gate is applied
# WEB_PORT=8000
# WATCH_CHANNELS=https://www.youtube.com/@WhiteHouse/live,https://www.youtube.com/@cspan/live
# WATCH_TITLE_PATTERNS=president,cabinet meeting   # substrings a live title must contain; add the figure's name
# YTDLP_COOKIES_FROM_BROWSER=chrome

# Firebase sink (Stage 2 prep): Firestore feed + FCM pushes. Off by default.
# FIREBASE_ENABLED=1
# FIREBASE_PROJECT_ID=your-firebase-project
# FIREBASE_CREDENTIALS=/absolute/path/to/secrets/your-firebase-project-sa.json   # service-account JSON; omit to use ADC
# FCM_TOPIC=alerts
# FCM_DRY_RUN=1                  # 1 = FCM validates the push but delivers nothing; log says "would push"
# FCM_PUSH_ON_LIVE=1             # also push "<figure> is live" when a stream is attached
# FIREBASE_TRANSCRIPTS=1         # write final transcript segments to streams/{id}/segments for the hosted page

# Always-on watch daemon
# WATCH_POLL_SECONDS=60
# WATCH_IGNORE_ENDED_HOURS=6     # do not re-attach a video id for this long after it ended
# WATCH_ATTACH_RETRIES=3         # re-attach attempts while the stream is still live after a crash
# LIVE_STALL_SECONDS=45          # no new segment for this long -> ask YouTube if it is still live
# LIVE_RESYNC_ATTEMPTS=5
